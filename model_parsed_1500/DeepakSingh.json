  "projects": [
    {
      "id": "proj_1",
      "name": "Data Model",
      "client": "",
      "role": "",
      "duration": "",
      "details": [
        "• Drove end-to-end platform ownership across enterprise-scale retail data platform architecture,",
        "delivery, and lifecycle governance while leading a cross-functional team of 7 data engineers across",
        "solution design, code reviews, and release planning.",
        "• Defined enterprise data strategy and architected scalable dimensional data models and lakehouse",
        "architecture for multi-billion-record sales datasets, enabling governed, high-performance analytics",
        "across multiple retail business domains.",
        "• Designed ingestion and transformation frameworks for ServiceNow operational data, improving incident",
        "analytics and operational visibility.",
        "• Strengthened data reliability by integrating Monte Carlo-based observability and anomaly detection,",
        "reducing production data incidents by 40% and improving SLA adherence.",
        "• Spearheaded AI-assisted engineering initiatives using Windsurf and GitHub Copilot  to accelerate software",
        "delivery, improve code quality, and enhance engineering productivity.",
        "• Architected and developed a scalable Databricks-based chargeback dispute analytics platform that",
        "consolidated multi-source transaction data and automated evidence generation for Stripe and American",
        "Express disputes, improving dispute win rates by 35% and protecting $2M in revenue."
      ]
    },
    {
      "id": "proj_2",
      "name": "Risk Analytics Platform",
      "client": "",
      "role": "",
      "duration": "",
      "details": [
        "• Led the architecture and development of cloud-native ETL pipelines for user behavior analytics and",
        "risk scoring, enabling proactive detection of phishing-risk patterns and driving targeted training that",
        "reduced employee susceptibility by 86% and breach risk by 25%.",
        "• Designed and implemented event-driven architecture leveraging Lambda, Step Functions, and EMR",
        "Serverless for large-scale user behavior analytics, improving scalability and operational efficiency.",
        "• Designed a generative AI-based proof of concept using AWS Bedrock for automated unit test",
        "generation and AI-assisted pull request creation, improving developer productivity.",
        "• Optimized CI/CD release pipelines by integrating schema migrations and automated deployment validation,",
        "improving deployment reliability and reducing manual release effort.",
        "• Mentored engineering teams on distributed data processing, cloud -native architecture, and modern data",
        "engineering practices."
      ]
    },
    {
      "id": "proj_3",
      "name": "Service Assurance Data Platform",
      "client": "",
      "role": "",
      "duration": "",
      "details": [
        "• Architected data ingestion pipelines to extract high-volume telecom IMS session data and publish it to Kafka, enabling service assurance platforms to monitor call success and server latency.",
        "• Developed microservices-based APIs using FastAPI to support downstream operational integrations.",
        "• Increased code maintainability and deployment quality by integrating SonarQube coverage validation into CI/CD pipelines."
      ]
    },
    {
      "id": "proj_4",
      "name": "Revenue Assurance & Analytics Platform",
      "client": "",
      "role": "",
      "duration": "",
      "details": [
        "• Engineered scalable ETL pipelines processing millions of Call Detail Records (CDRs) daily to support telecom",
        "charging, billing, and inter-operator roaming settlement.",
        "• Integrated processed telecom data with Enterprise Data Warehouse (EDW) and convergent billing",
        "systems, enabling downstream analytics, reporting, and financial reconciliation."
      ]
    }
