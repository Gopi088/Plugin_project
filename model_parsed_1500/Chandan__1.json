  "projects": [
    {
      "id": "proj_1",
      "name": "Mandates & Payment Platform (NACH, UPI Autopay, APBS)",
      "client": "",
      "role": "",
      "duration": "",
      "details": [
        "Responsibilities",
        "• Led end-to-end requirement gathering for NPCI payment platforms supporting",
        "NACH, UPI Autopay, e-Mandate, Paper Mandates and Aadhaar-based services.",
        "• Managed complete mandate lifecycle including onboarding, validation, execution,",
        "reconciliation and exception handling.",
        "• Prepared BRD, FRD/FSD, solution scope documents and business process flows",
        "aligned with NPCI and banking regulations.",
        "• Designed inward and outward payment flows covering authentication, settlement,",
        "consent management and reversals.",
        "• Used Python (Pandas) along with SQL to perform payment data validation, reconcile",
        "transaction datasets, automate data quality checks, and generate analytical",
        "datasets for Power BI reporting and business insight",
        "• Coordinated with banks, NPCI and internal stakeholders during UAT, certification,",
        "audit readiness and production deployment.",
        "• Supported onboarding of more than 1 million payment records, achieving 99%+",
        "mandate success rate after go-live."
      ]
    },
    {
      "id": "proj_2",
      "name": "Rent Collection & Mandate Platform",
      "client": "",
      "role": "",
      "duration": "",
      "details": [
        "• Gathered and analyzed business requirements for API integrations between Core",
        "Banking Systems, partner platforms and Sohar International Bank.",
        "• Performed interface analysis and data mapping for secure system integrations.",
        "• Worked closely with Product, Business and Development teams throughout",
        "delivery.",
        "• Improved mandate execution turnaround by 30–40% through optimized API",
        "workflows.",
        "• Configured and validated APIs using Postman.",
        "• Supported deployment and production stabilization activities."
      ]
    },
    {
      "id": "proj_3",
      "name": ", Audit & Information Security Compliance",
      "client": "",
      "role": "",
      "duration": "",
      "details": [
        "• Supported VAPT, SOC2, ISO 27001:2022 and PCI DSS audit programs.",
        "• Coordinated with auditors and internal stakeholders for evidence collection and",
        "audit closure.",
        "• Ensured compliance with NPCI, UIDAI and regulatory standards.",
        "• Achieved 100% audit closure with zero critical observations."
      ]
    },
    {
      "id": "proj_4",
      "name": "Deposit Subscription Analytics",
      "client": "",
      "role": "",
      "duration": "",
      "details": [
        "Business Problem",
        "The bank experienced declining revenue due to reduced customer term deposit",
        "subscriptions.",
        "Responsibilities",
        "• Performed problem identification and requirement gathering.",
        "• Prepared functional documentation.",
        "• Extracted customer data using SQL.",
        "• Exported database records into CSV for analytical processing.",
        "• Built Power BI dashboards.",
        "• Used Python for data analysis and insight generation.",
        "• Supported testing and solution implementation.",
        "Tools Used",
        "• SQL",
        "• Python",
        "• Power BI",
        "• Google Docs"
      ]
    }
