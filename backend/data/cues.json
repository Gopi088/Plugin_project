{
 "_comment": "Tunable vocabularies for the resume pipeline. Edit these instead of code. Override path via RT_CUES_PATH env var. Entries marked (regex) are regular-expression fragments.",
 "section_headers": {
  "EXPERIENCE": [
   "PROFESSIONAL EXPERIENCE",
   "WORK EXPERIENCE",
   "EMPLOYMENT HISTORY",
   "EXPERIENCE",
   "INTERNSHIP",
   "INTERNSHIPS"
  ],
  "EDUCATION": [
   "EDUCATION",
   "ACADEMIC",
   "QUALIFICATION"
  ],
  "PROJECTS": [
   "KEY PROJECTS",
   "PROJECT PROFILE",
   "PROJECTS PROFILE",
   "PROJECTS"
  ],
  "SKILLS": [
   "TECHNICAL SKILLS",
   "SKILLS"
  ]
 },
 "company_suffixes_regex": [
  "Pvt\\.?\\s*Ltd\\.?(?!\\w)",
  "Pvt Ltd",
  "Ltd\\.?(?!\\w)",
  "Inc\\.?(?!\\w)",
  "LLP(?!\\w)",
  "Technologies",
  "Technology",
  "Solutions",
  "Systems",
  "Services",
  "Consulting",
  "Digital",
  "Engineering",
  "Labs(?!\\w)",
  "Group(?!\\w)",
  "Bank(?!\\w)",
  "Infotech",
  "Client\\s*:",
  "Company\\s*:",
  "Organization\\s*"
 ],
 "title_words_regex": [
  "Engineer",
  "Developer",
  "Analyst",
  "Manager",
  "Consultant",
  "Architect",
  "Tester",
  "Lead",
  "Administrator",
  "Specialist",
  "Owner",
  "Head",
  "Intern",
  "Associate",
  "Designer",
  "Scientist"
 ],
 "degree_words_regex": [
  "B\\.?\\s*E\\.?",
  "B\\.?\\s*Tech",
  "Bachelor",
  "M\\.?\\s*Tech",
  "Master",
  "MCA(?!\\w)",
  "MBA(?!\\w)",
  "BCA(?!\\w)",
  "Diploma",
  "Ph\\.?\\s*D",
  "B\\.?\\s*Sc",
  "M\\.?\\s*Sc",
  "B\\.?\\s*Com",
  "SSC(?!\\w)",
  "HSC(?!\\w)",
  "CGPA",
  "University",
  "College",
  "Institute",
  "School"
 ],
 "job_family_words_regex": [
  "Software",
  "Data",
  "AI",
  "ML",
  "Full[\\s\\-]?Stack",
  "Backend",
  "Frontend",
  "DevOps",
  "Cloud",
  "RPA",
  "Business",
  "Project",
  "Product",
  "Test",
  "QA",
  "System"
 ],
 "internship_words": [
  "intern"
 ],
 "nav_terms_regex": [
  "leetcode",
  "hackerrank",
  "codechef",
  "github\\.com",
  "linkedin",
  "transformed\\s+by",
  "references",
  "declaration",
  "^https?://",
  "www\\."
 ],
 "project_field_labels_regex": [
  "Client\\s*(?:Name)?\\s*:\\s*(.+)",
  "Project\\s*(?:Name|Title)?\\s*:\\s*(.+)",
  "Role\\s*:\\s*(.+)"
 ],
 "present_words_regex": [
  "present",
  "till\\s+date",
  "to\\s+date",
  "current",
  "now",
  "ongoing",
  "till\\s+now",
  "tilldate"
 ],
 "strip_leading_caps": {
  "enabled": true,
  "min_length": 3
 },
 "two_digit_year_cutoff": 39,
 "attention_defaults": {
  "minimumGapMonthsForHighAttention": 4,
  "minimumConfidenceForHighAttention": 0.7,
  "minorGapMonths": 2,
  "lowConfidenceThreshold": 0.5
 },
