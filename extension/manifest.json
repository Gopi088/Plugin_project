{
  "manifest_version": 3,
  "name": "Resume Timeline & Gap Detection",
  "version": "1.1.6",
  "description": "Reconstructs a candidate timeline from the resume on screen and flags potential unrepresented periods. Gaps are never claims of unemployment.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "webNavigation",
    "sidePanel",
    "debugger"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "file:///*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "api.js",
        "viewmodel.js",
        "source-viewer.js",
        "content.js"
      ],
      "css": [
        "sidebar.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Resume Timeline"
  },
  "side_panel": {
    "default_path": "viewer.html"
  },
  "minimum_chrome_version": "125"
}
